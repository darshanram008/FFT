set_ideal_network [get_ports clk]
create_clock [get_ports clk]  -period 2  -waveform {0 1}
set_clock_uncertainty 0  [get_clocks clk]
set_clock_transition -max -rise 0.04 [get_clocks clk]
set_clock_transition -max -fall 0.04 [get_clocks clk]
set_clock_transition -min -rise 0.04 [get_clocks clk]
set_clock_transition -min -fall 0.04 [get_clocks clk]
set_input_delay -clock clk  0.05  [get_ports wen]
set_input_delay -clock clk  0.05  [get_ports rstn]
set_input_delay -clock clk  0.05  [get_ports {seed[15]}]
set_input_delay -clock clk  0.05  [get_ports {seed[14]}]
