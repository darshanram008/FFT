###################################################################
set sdc_version 1.7

set_units -time ns -resistance kOhm -capacitance pF -voltage V -current mA
set_max_fanout 4 [current_design]
set_driving_cell -lib_cell INVD0 [get_ports clk]
set_driving_cell -lib_cell INVD0 [get_ports wen]
set_driving_cell -lib_cell INVD0 [get_ports rstn]
set_driving_cell -lib_cell INVD0 [get_ports {seed[15]}]
set_driving_cell -lib_cell INVD0 [get_ports {seed[14]}]
set_driving_cell -lib_cell INVD0 [get_ports {seed[13]}]
set_driving_cell -lib_cell INVD0 [get_ports {seed[12]}]
set_driving_cell -lib_cell INVD0 [get_ports {seed[11]}]
set_driving_cell -lib_cell INVD0 [get_ports {seed[10]}]
set_driving_cell -lib_cell INVD0 [get_ports {seed[9]}]
set_driving_cell -lib_cell INVD0 [get_ports {seed[8]}]
set_driving_cell -lib_cell INVD0 [get_ports {seed[7]}]
set_driving_cell -lib_cell INVD0 [get_ports {seed[6]}]
set_driving_cell -lib_cell INVD0 [get_ports {seed[5]}]
set_driving_cell -lib_cell INVD0 [get_ports {seed[4]}]
set_driving_cell -lib_cell INVD0 [get_ports {seed[3]}]
set_driving_cell -lib_cell INVD0 [get_ports {seed[2]}]
set_driving_cell -lib_cell INVD0 [get_ports {seed[1]}]
set_driving_cell -lib_cell INVD0 [get_ports {seed[0]}]
set_load -pin_load 0.005 [get_ports {sign[15]}]
set_load -pin_load 0.005 [get_ports {sign[14]}]
