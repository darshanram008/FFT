set_load -pin_load 0.005 [get_ports {sign[7]}]
set_load -pin_load 0.005 [get_ports {sign[6]}]
set_load -pin_load 0.005 [get_ports {sign[5]}]
set_load -pin_load 0.005 [get_ports {sign[4]}]
set_load -pin_load 0.005 [get_ports {sign[3]}]
set_load -pin_load 0.005 [get_ports {sign[2]}]
set_load -pin_load 0.005 [get_ports {sign[1]}]
set_load -pin_load 0.005 [get_ports {sign[0]}]
set_max_capacitance 0.005 [get_ports clk]
set_max_capacitance 0.005 [get_ports wen]
set_max_capacitance 0.005 [get_ports rstn]
set_max_capacitance 0.005 [get_ports {seed[15]}]
