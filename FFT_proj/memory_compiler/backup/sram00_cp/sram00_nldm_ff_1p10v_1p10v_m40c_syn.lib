  voltage_map (VDD, 1.1);
  voltage_map (VSS, 0);
  operating_conditions(ff_1p10v_1p10v_m40c) {
    process      : 1;
    temperature  : -40.000;
    voltage      : 1.100;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ff_1p10v_1p10v_m40c;

