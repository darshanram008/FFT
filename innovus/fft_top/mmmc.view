# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line

create_rc_corner \
-cap_table {/courses/ee6350/pdk2025/tcbn65gplus/TSMCHOME/digital/Back_End/lef/tcbn65gplus_200a/techfiles/captable/cln65g+_1p09m+alrdl_typical_top2.captable} \
-name typical_rc \
-preRoute_res {1.0} \
-preRoute_cap {1.0} \
-preRoute_clkres {0.0} \
-preRoute_clkcap {0.0} \
-postRoute_res {1.0} \
-postRoute_cap {1.0} \
-postRoute_xcap {1.0} \
-postRoute_clkres {0.0} \
-postRoute_clkcap {0.0}

create_library_set \
-name typical_lib \
-timing {/courses/ee6350/pdk2025/tcbn65gplus/TSMCHOME/digital/Front_End/timing_power_noise/CCS/tcbn65gplus_200a/tcbn65gplustc_ccs.lib \
../../innovus/fft_controller/fft_controller.lib \
../../innovus/fft_address_gen/fft_address_gen.lib \
../../innovus/fft_core/fft_core.lib \
../../innovus/fft_data_sram/fft_data_sram.lib \
../../innovus/fft_twiddle_sram/fft_twiddle_sram.lib \
}

# Note: need to comment out the set_ideal_clock in the sdc file
create_constraint_mode \
-name typical_constraint \
-sdc_files {../../dc/fft_top/fft_top.syn.sdc}

create_delay_corner \
-name typical_dly \
-library_set {typical_lib} \
-rc_corner {typical_rc}

create_analysis_view \
-name typical \
-constraint_mode {typical_constraint} \
-delay_corner {typical_dly}

set_analysis_view \
-setup {typical} \
-hold {typical}
