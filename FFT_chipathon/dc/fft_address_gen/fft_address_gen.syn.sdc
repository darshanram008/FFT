set_input_delay -clock vclk  0.1  [get_ports {linear_addr[0]}]
set_output_delay -clock vclk  0.05  [get_ports {x0_addr[6]}]
set_output_delay -clock vclk  0.05  [get_ports {x0_addr[5]}]
set_output_delay -clock vclk  0.05  [get_ports {x0_addr[4]}]
