set_max_capacitance 0.01 [get_ports {linear_addr[1]}]
set_max_capacitance 0.01 [get_ports {linear_addr[0]}]
set_max_fanout 4 [get_ports {stage[2]}]
set_max_fanout 4 [get_ports {stage[1]}]
set_max_fanout 4 [get_ports {stage[0]}]
set_max_fanout 4 [get_ports {group[5]}]
set_max_fanout 4 [get_ports {group[4]}]
set_max_fanout 4 [get_ports {group[3]}]
set_max_fanout 4 [get_ports {group[2]}]
set_max_fanout 4 [get_ports {group[1]}]
set_max_fanout 4 [get_ports {group[0]}]
set_max_fanout 4 [get_ports {bfly[5]}]
set_max_fanout 4 [get_ports {bfly[4]}]
set_max_fanout 4 [get_ports {bfly[3]}]
set_max_fanout 4 [get_ports {bfly[2]}]
set_max_fanout 4 [get_ports {bfly[1]}]
set_max_fanout 4 [get_ports {bfly[0]}]
set_max_fanout 4 [get_ports {linear_addr[6]}]
set_max_fanout 4 [get_ports {linear_addr[5]}]
set_max_fanout 4 [get_ports {linear_addr[4]}]
set_max_fanout 4 [get_ports {linear_addr[3]}]
set_max_fanout 4 [get_ports {linear_addr[2]}]
set_max_fanout 4 [get_ports {linear_addr[1]}]
set_max_fanout 4 [get_ports {linear_addr[0]}]
create_clock -name vclk  -period 2  -waveform {0 1}
set_clock_uncertainty 0  [get_clocks vclk]
set_input_delay -clock vclk  0.1  [get_ports {stage[2]}]
set_input_delay -clock vclk  0.1  [get_ports {stage[1]}]
