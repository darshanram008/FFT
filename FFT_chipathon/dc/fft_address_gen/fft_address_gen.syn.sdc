set_input_delay -clock vclk  0.1  [get_ports {bfly[4]}]
set_input_delay -clock vclk  0.1  [get_ports {bfly[3]}]
set_input_delay -clock vclk  0.1  [get_ports {bfly[2]}]
set_input_delay -clock vclk  0.1  [get_ports {bfly[1]}]
set_input_delay -clock vclk  0.1  [get_ports {bfly[0]}]
